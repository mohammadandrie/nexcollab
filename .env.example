# Copy to .env and fill in real values. .env is git-ignored.

# Hermes gateway (OpenAI-compatible)
NEXCOLLAB_LLM_BASE=http://127.0.0.1:1430/v1
NEXCOLLAB_LLM_KEY=replace-with-your-key
NEXCOLLAB_LLM_MODEL=kiro/claude-sonnet-4.6

# MongoDB
NEXCOLLAB_MONGO_URL=mongodb://127.0.0.1:27017
NEXCOLLAB_MONGO_DB=nexcollab

# Session signing secret (any long random string)
NEXCOLLAB_SECRET=change-me-to-a-long-random-string

# Server bind
NEXCOLLAB_HOST=127.0.0.1
NEXCOLLAB_PORT=8091
